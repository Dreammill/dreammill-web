---
// Image, looping clip, or a typographic placeholder in a fixed aspect ratio.
interface Props { title: string; image?: string; loop?: string; tint?: string; ratio?: string; eager?: boolean; label?: string }
const { title, image, loop, tint = '#8a6a3b', ratio = '2.39 / 1', eager = false, label } = Astro.props;
---
<div class="frame" style={`aspect-ratio:${ratio};--tint:${tint}`}>
  {loop ? (
    <video src={loop} poster={image} autoplay muted loop playsinline preload="metadata" aria-hidden="true"></video>
  ) : image ? (
    <img src={image} alt={title} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  ) : (
    <div class="ph" aria-hidden="true">
      <span class="ph__t">{title}</span>
      {label && <span class="ph__l">{label}</span>}
    </div>
  )}
</div>
<style>
  .frame { position: relative; overflow: hidden; background: var(--ink-2); width: 100%; }
  img, video { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s cubic-bezier(.2,.7,.2,1); }
  .ph {
    position: absolute; inset: 0; display: grid; place-items: center; padding: 8%;
    background:
      radial-gradient(120% 90% at 18% 20%, color-mix(in srgb, var(--tint) 70%, transparent), transparent 60%),
      radial-gradient(90% 80% at 90% 100%, color-mix(in srgb, var(--tint) 35%, #000), transparent 70%),
      linear-gradient(180deg, #121214, #070708);
  }
  .ph::before {
    content: ''; position: absolute; inset: 0;
    background: repeating-linear-gradient(90deg, rgba(255,255,255,0.025) 0 1px, transparent 1px 6px);
    mix-blend-mode: overlay;
  }
  .ph__t { font-family: var(--serif); font-size: clamp(28px, 4.5vw, 64px); text-align: center; line-height: 0.95; color: rgba(236,230,218,0.9); position: relative; }
  .ph__l { position: absolute; left: 16px; bottom: 12px; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(236,230,218,0.5); }
</style>
